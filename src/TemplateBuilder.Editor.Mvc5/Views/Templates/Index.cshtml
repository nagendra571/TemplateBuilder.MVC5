@using System.Linq
@using TemplateBuilder.Editor.Mvc5.Models
@model TemplateListViewModel

<div id="tb-editor-host" class="tb-theme-light tb-index-page">
    @Html.AntiForgeryToken()

    <div class="tb-page-content">

        <!-- Page Header -->
        <div class="tb-page-header">
            <div>
                <h1 class="tb-page-title">Templates</h1>
                <p style="color:var(--text-muted);font-size:13px;margin-top:2px;">Manage your reusable document templates</p>
            </div>
            <div style="display:flex;gap:8px;">
                <a class="btn btn-secondary" href="@Url.Action("Index", "Audit")">Audit Log</a>
                <a class="btn btn-secondary" href="@Url.Action("Index", "Health")">Health</a>
                <button type="button" id="btn-import-open" class="btn btn-secondary">Import</button>
                <a class="btn btn-primary" href="@Url.Action("Create", "Templates")">+ New Template</a>
            </div>
        </div>

        <!-- Bulk toolbar (hidden until selection) -->
        <div id="tb-bulk-bar" class="tb-bulk-bar" hidden>
            <span id="tb-bulk-count" class="tb-bulk-count">0 selected</span>
            <button type="button" id="btn-bulk-activate" class="btn btn-sm btn-secondary">Activate</button>
            <button type="button" id="btn-bulk-deactivate" class="btn btn-sm btn-secondary">Deactivate</button>
            <button type="button" id="btn-bulk-export" class="btn btn-sm btn-secondary">Export ZIP</button>
            <button type="button" id="btn-bulk-delete" class="btn btn-sm btn-danger">Delete</button>
            <button type="button" id="btn-bulk-clear" class="btn btn-sm btn-ghost">Clear</button>
        </div>

        <!-- Layout: main list + stats sidebar -->
        <div class="tb-list-layout">
            <div class="tb-list-main">

                <!-- Search + Filter -->
                <form method="get" action="@Url.Action("Index", "Templates")" class="tb-search-row" role="search">
                    <div style="flex:1;max-width:320px;">
                        <label for="search-input" class="visually-hidden">Search templates</label>
                        <input type="search" id="search-input" name="search" value="@Model.Search" placeholder="Search templates…" />
                    </div>
                    <div>
                        <label for="type-filter" class="visually-hidden">Filter by type</label>
                        <select id="type-filter" name="type" style="width:160px;">
                            <option value="">All Types</option>
                            @foreach (var type in TemplateListViewModel.KnownTypes)
                            {
                                <option value="@type" @(Model.TypeFilter == type ? "selected" : "")>@type</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-secondary">Filter</button>
                </form>

                <!-- Template Table -->
                @if (!Model.Templates.Any())
                {
                    <div class="card tb-empty-state">
                        <p>No templates found.@(string.IsNullOrWhiteSpace(Model.Search) ? "" : " Try adjusting the search or filter.")</p>
                    </div>
                }
                else
                {
                    <div class="card" style="overflow:hidden;">
                        <table class="tb-list-table" role="table" aria-label="Template list">
                            <thead>
                                <tr>
                                    <th scope="col" class="tb-check-col"><input type="checkbox" id="tb-check-all" aria-label="Select all templates"></th>
                                    <th scope="col">Health</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Version</th>
                                    <th scope="col">Updated</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" style="text-align:right;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var template in Model.Templates)
                                {
                                    <tr id="row-@template.Id">
                                        <td class="tb-check-col"><input type="checkbox" class="tb-row-check" value="@template.Id" aria-label="Select @template.Name"></td>
                                        <td class="tb-health-col"><span class="tb-health-badge" data-template-id="@template.Id">—</span></td>
                                        <td class="tb-col-name">@template.Name</td>
                                        <td>
                                            <span class="tb-badge tb-badge-@template.TemplateType.ToLowerInvariant()">@template.TemplateType</span>
                                        </td>
                                        <td class="tb-col-meta">v@(template.CurrentVersion?.VersionNumber ?? 0)</td>
                                        <td class="tb-col-meta">@template.UpdatedAt.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <span id="status-@template.Id"
                                                  class="tb-badge @(template.IsActive ? "tb-badge-live" : "tb-badge-draft")">
                                                @(template.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td class="tb-col-actions">
                                            <div style="display:flex;gap:4px;justify-content:flex-end;">
                                                <a class="btn btn-sm btn-secondary" href="@Url.Action("Edit", "Templates", new { id = template.Id })">Edit</a>
                                                <a class="tb-action-link" style="align-self:center;" href="@Url.Action("ExportTemplate", "Templates", new { id = template.Id })">Export</a>
                                                <button type="button" class="btn btn-sm btn-secondary"
                                                        data-template-name="@template.Name"
                                                        onclick="openDuplicateModal(@template.Id, this.dataset.templateName)">Duplicate</button>
                                                <button type="button" class="btn btn-sm btn-secondary"
                                                        id="toggle-btn-@template.Id"
                                                        onclick="toggleActive(@template.Id, this)">
                                                    @(template.IsActive ? "Disable" : "Enable")
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Stats Sidebar -->
            @if (Model.Templates.Any())
            {
                <div class="card tb-stats-sidebar">
                    <div style="padding:14px 16px 6px;border-bottom:1px solid var(--border);">
                        <h3 style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.6px;">Quick Stats</h3>
                    </div>
                    <div style="padding:10px 16px 14px;">
                        <div class="tb-stat-total">@Model.Templates.Count</div>
                        <div style="font-size:11px;color:var(--text-muted);margin-bottom:12px;">Total templates</div>
                        @foreach (var kvp in Model.CountByType)
                        {
                            <div class="tb-stat-row">
                                <span class="tb-stat-label">@kvp.Key</span>
                                <span class="tb-stat-value">@kvp.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

    </div>

    <!-- Import Modal -->
    <div class="modal-overlay" id="import-modal" role="dialog" aria-modal="true" aria-labelledby="import-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="import-modal-title" class="modal-title">Import templates</span>
                <button type="button" class="modal-close" id="btn-import-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body">
                <div class="tb-form-row">
                    <label for="import-file">Export file (.template.json)</label>
                    <input type="file" id="import-file" accept=".json">
                </div>
                <p class="tb-import-hint">Matched by external key — the same template in dev is updated, new templates are created. Review/Approved targets are skipped. Status: Review/Approved import as Draft.</p>
                <div id="import-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                <button type="button" id="btn-import-submit" class="btn btn-primary">Import</button>
                <div id="import-result" class="tb-import-result"></div>
            </div>
        </div>
    </div>

    <!-- Duplicate Modal -->
    <div class="modal-overlay" id="duplicate-modal" role="dialog" aria-modal="true" aria-labelledby="duplicate-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="duplicate-modal-title" class="modal-title">Duplicate Template</span>
                <button class="modal-close" aria-label="Close" onclick="closeDuplicateModal()">&#x2715;</button>
            </div>
            <div class="modal-body">
                <div class="tb-form-row">
                    <label for="duplicate-name-input">New Template Name</label>
                    <input type="text" id="duplicate-name-input" autocomplete="off" />
                </div>
                <div class="tb-modal-actions">
                    <button class="btn btn-secondary" onclick="closeDuplicateModal()">Cancel</button>
                    <button class="btn btn-primary" onclick="confirmDuplicate()">Duplicate</button>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // _csrf is provided by the package's template-editor.js (loaded by the host layout).
    async function toggleActive(id, btn) {
        btn.disabled = true;
        const res = await fetch(`/Templates/${id}/ToggleActive`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': _csrf }
        });
        btn.disabled = false;
        if (res.ok) {
            const data = await res.json();
            const statusEl = document.getElementById(`status-${id}`);
            statusEl.className = `tb-badge ${data.isActive ? 'tb-badge-live' : 'tb-badge-draft'}`;
            statusEl.textContent = data.isActive ? 'Active' : 'Inactive';
            btn.textContent = data.isActive ? 'Disable' : 'Enable';
        } else {
            const err = await res.json().catch(() => null);
            alert(err?.message ?? 'Failed to update template status.');
        }
    }

    let _duplicateSourceId = null;

    function openDuplicateModal(id, name) {
        _duplicateSourceId = id;
        document.getElementById('duplicate-name-input').value = `Copy of ${name}`;
        document.getElementById('duplicate-modal').classList.add('open');
        setTimeout(() => document.getElementById('duplicate-name-input').focus(), 50);
    }

    function closeDuplicateModal() {
        document.getElementById('duplicate-modal').classList.remove('open');
        _duplicateSourceId = null;
    }

    async function confirmDuplicate() {
        const newName = document.getElementById('duplicate-name-input').value.trim();
        if (!newName) return;
        const confirmBtn = document.querySelector('#duplicate-modal .btn-primary');
        confirmBtn.disabled = true;
        const res = await fetch(`/Templates/${_duplicateSourceId}/Duplicate`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': _csrf
            },
            body: JSON.stringify({ newName })
        });
        confirmBtn.disabled = false;
        if (res.ok) {
            const { id } = await res.json();
            window.location.href = `/Templates/${id}/Edit`;
        } else {
            const err = await res.json().catch(() => null);
            alert(err?.message ?? 'Failed to duplicate template.');
            closeDuplicateModal();
        }
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && document.getElementById('duplicate-modal').classList.contains('open'))
            closeDuplicateModal();
    });
</script>