@using TemplateBuilder.Editor.Mvc5.Models
@using TemplateBuilder.Application.Services
@model TemplateEditorViewModel

<div id="tb-editor-host">
    @Html.ValidationSummary(true, "", new { @class = "tb-validation-summary" })

    <form id="editor-form" method="post" action="@Url.Action(Model.Id.HasValue ? "SaveVersion" : "Create", "Templates", Model.Id.HasValue ? (object)new { id = Model.Id } : null)">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.CurrentVersionId)
        @Html.HiddenFor(m => m.CurrentVersionNumber)

        <div class="tb-editor-grid">

            <!-- LEFT: Field Palette -->
            <div class="tb-panel-left">
                <div class="tb-panel-heading" id="palette-heading"><span class="tb-heading-icon">&#8854;</span> FIELD PALETTE
                    <button type="button" id="btn-ref-open" class="tb-ref-open-btn" title="Scriban syntax reference">?</button>
                </div>
                <div class="tb-view-selector-row">
                    <label for="view-selector">SQL View</label>
                    <select id="view-selector">
                        <option value="">&#8212; Select a view &#8212;</option>
                        @foreach (var view in Model.AvailableViews)
                        {
                            <option value="@view">@view</option>
                        }
                    </select>
                </div>
                <div class="tb-palette-search-row">
                    <input type="search" id="palette-search" class="tb-palette-search" placeholder="Search fields&#8230;" autocomplete="off" aria-label="Search fields">
                </div>
                <div id="field-palette" aria-live="polite">
                    <div class="tb-palette-msg">Select a view to see fields</div>
                </div>
                <div class="tb-blocks-section">
                    <div class="tb-section-label">BLOCKS</div>
                    <div class="tb-blocks-list">
                        <div class="palette-block" draggable="true" data-block="loop">Loop Block</div>
                        <div class="palette-block" draggable="true" data-block="grid">Grid Block</div>
                    </div>
                </div>
                <div class="tb-snippets-section">
                    <div class="tb-section-label">SNIPPETS</div>
                    <div id="snippet-list" aria-live="polite">
                        <div class="tb-palette-msg">Loading snippets&#8230;</div>
                    </div>
                    <button type="button" id="btn-save-snippet" class="tb-snippet-save-btn"
                            title="Save selected editor content as a reusable snippet">
                        <span aria-hidden="true">&#8853;</span> Save selection as snippet&#8230;
                    </button>
                </div>
            </div>

            <!-- CENTER: Canvas -->
            <div class="tb-panel-center">
                <div class="tb-panel-heading">
                    <span class="tb-heading-icon">&#9998;</span> CANVAS
                    <div class="tb-heading-actions">
                        <button type="button" id="btn-theme-toggle" class="tb-theme-toggle" aria-label="Toggle theme"></button>
                    </div>
                </div>
                <div id="validate-panel" class="tb-validate-panel" hidden>
                    <span id="validate-msg"></span>
                    <button type="button" id="btn-validate-dismiss" class="tb-validate-dismiss" aria-label="Dismiss">&#x2715;</button>
                </div>
                <div class="tb-canvas-body">
                    <textarea id="template-body" name="Body" spellcheck="false">@Model.Body</textarea>
                </div>
                <div id="tb-word-count" class="tb-word-count" aria-live="polite">
                    <span>Words: <strong id="wc-words">0</strong></span>
                    <span class="tb-wc-sep">&#183;</span>
                    <span>Characters: <strong id="wc-chars">0</strong></span>
                    <span class="tb-wc-sep">&#183;</span>
                    <span>No spaces: <strong id="wc-nospace">0</strong></span>
                </div>
            </div>

            <!-- RIGHT: Properties -->
            <div class="tb-panel-right">
                <div class="tb-panel-heading"><span class="tb-heading-icon">&#9881;</span> PROPERTIES</div>
                <div class="tb-props-body">
                    <div>
                        <label for="prop-name">Template Name</label>
                        <input id="prop-name" type="text" name="Name" value="@Model.Name" maxlength="200" />
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "tb-field-error" })
                    </div>
                    <div>
                        <label for="prop-type">Type</label>
                        <select id="prop-type" name="TemplateType">
                            @foreach (var type in TemplateListViewModel.KnownTypes)
                            {
                                <option value="@type" @(Model.TemplateType == type ? "selected" : "")>@type</option>
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.TemplateType, "", new { @class = "tb-field-error" })
                    </div>
                    <div>
                        <label for="prop-desc">Description</label>
                        <textarea id="prop-desc" rows="2" name="Description" maxlength="500">@Model.Description</textarea>
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "tb-field-error" })
                    </div>
                    <div>
                        <label for="prop-source-view">Source SQL View</label>
                        <select id="prop-source-view" name="SourceView">
                            <option value="">— unbound —</option>
                            @foreach (var view in Model.AvailableViews)
                            {
                                <option value="@view" @(Model.SourceView == view ? "selected" : "")>@view</option>
                            }
                        </select>
                    </div>
                    @if (Model.Id.HasValue)
                    {
                        <div>
                            <label>Version</label>
                            <div class="tb-version-row">
                                <span id="version-display">v @Model.CurrentVersionNumber</span>
                                @if (Model.Id.HasValue && !Model.LatestVersionIsActive)
                                {
                                    <span id="draft-version-badge" class="tb-badge tb-badge-draft">Draft version</span>
                                }
                                <button type="button" id="btn-history" class="btn btn-sm btn-secondary">History</button>
                            </div>
                        </div>
                        <div>
                            <label for="save-comment">Save Note (optional)</label>
                            <input type="text" id="save-comment" placeholder="What changed?" />
                        </div>
                    }
                </div>
                <div class="tb-props-footer">
                    <div id="save-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                    @if (Model.Id.HasValue)
                    {
                        <button type="button" id="btn-preview" class="btn btn-secondary">Preview</button>
                        <button type="button" id="btn-health" class="btn btn-secondary">Health</button>
                        <button type="button" id="btn-save-draft" class="btn btn-secondary">Save Draft</button>
                        <button type="button" id="btn-save-version" class="btn btn-primary">Save Version</button>
                        <div id="health-panel" class="tb-health-panel" hidden>
                            <div id="health-findings"></div>
                            <div id="health-meta" class="tb-health-meta"></div>
                        </div>
                    }
                    else
                    {
                        <button type="button" id="btn-create-submit" class="btn btn-primary">Create Template</button>
                    }
                </div>
            </div>

            <!-- Activity drawer (absolutely positioned — never affects grid flow) -->
            <button type="button" id="tb-activity-tab" class="tb-activity-tab"
                    aria-expanded="false" aria-controls="tb-activity-drawer" hidden>
                <span class="tb-activity-tab-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" width="14" height="14"
                         aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                </span>
                <span class="tb-activity-tab-label">Activity</span>
                <span id="tb-activity-count" class="tb-activity-count">0</span>
            </button>
            <aside id="tb-activity-drawer" class="tb-activity-drawer" hidden
                   role="dialog" aria-modal="false" aria-label="Activity timeline">
                <div class="tb-activity-header">
                    <span class="tb-activity-header-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round" width="13" height="13"
                             aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                        Activity
                    </span>
                    <button type="button" id="btn-activity-close" class="tb-activity-close" aria-label="Close">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" width="12" height="12" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    </button>
                </div>
                <div id="tb-timeline" class="tb-timeline"></div>
            </aside>
        </div>
    </form>

    <!-- Version History Modal -->
    <div class="modal-overlay" id="version-modal" role="dialog" aria-modal="true" aria-labelledby="version-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="version-modal-title" class="modal-title">Version History</span>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div id="restore-error" class="tb-error-msg" role="alert" style="display:none;"></div>
            <div class="modal-body" id="version-history-content">Loading&#8230;</div>
        </div>
    </div>

    <!-- Compare Modal -->
    <div class="modal-overlay" id="compare-modal" role="dialog" aria-modal="true" aria-labelledby="compare-modal-title">
        <div class="modal modal--compare">
            <div class="modal-header">
                <span id="compare-modal-title" class="modal-title">Compare Versions</span>
                <button type="button" id="btn-compare-back-history" class="btn btn-sm btn-secondary">&#8592; History</button>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div id="compare-error" class="tb-error-msg" role="alert" style="display:none;"></div>
            <div class="compare-panels">
                <div class="compare-panel">
                    <div class="compare-panel-header">
                        <span id="compare-current-num" class="tb-version-num"></span>
                        <span class="tb-version-badge">Current</span>
                        <span class="compare-panel-meta"></span>
                    </div>
                    <div class="compare-iframe-wrap">
                        <div class="compare-loading" id="compare-loading-current">Loading&#8230;</div>
                        <iframe id="compare-iframe-current" class="compare-iframe"
                                sandbox="allow-same-origin" title="Current version preview"></iframe>
                    </div>
                    <div class="compare-panel-actions">
                        <button type="button" id="btn-compare-keep" class="btn btn-sm btn-secondary">Keep Current</button>
                    </div>
                </div>
                <div class="compare-panel">
                    <div class="compare-panel-header">
                        <span id="compare-old-num" class="tb-version-num"></span>
                        <span id="compare-old-meta" class="compare-panel-meta"></span>
                    </div>
                    <div class="compare-iframe-wrap">
                        <div class="compare-loading" id="compare-loading-old">Loading&#8230;</div>
                        <iframe id="compare-iframe-old" class="compare-iframe"
                                sandbox="allow-same-origin" title="Selected version preview"></iframe>
                    </div>
                    <div class="compare-panel-actions">
                        <button type="button" id="btn-compare-restore" class="btn btn-sm btn-primary">Restore</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Modal -->
    <div class="modal-overlay" id="preview-modal" role="dialog" aria-modal="true" aria-labelledby="preview-modal-title">
        <div class="modal">
            <div class="modal-header">
                <span id="preview-modal-title" class="modal-title">Live Preview</span>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body">
                <div class="tb-form-row">
                    <div style="display:flex;align-items:baseline;justify-content:space-between;margin-bottom:4px;">
                        <label for="preview-json" style="margin:0;">Sample Data (JSON)</label>
                        <div class="tb-preview-actions">
                            <button type="button" id="btn-gen-save" class="btn btn-ghost btn-sm"
                                    title="Save this sample data to the template" style="display:none;">&#128190; Save to template</button>
                            <div class="tb-dropdown">
                                <button type="button" id="btn-gen-menu" class="btn btn-ghost btn-sm"
                                        aria-haspopup="menu" aria-expanded="false">&#9889; Generate &#9662;</button>
                                <div class="tb-dropdown-menu" id="gen-menu" role="menu" hidden>
                                    <button type="button" class="tb-gen-option" data-gen="view" role="menuitem">From SQL view</button>
                                    <button type="button" class="tb-gen-option" data-gen="tokens" role="menuitem">From template tokens</button>
                                    <button type="button" class="tb-gen-option" data-gen="both" role="menuitem">Both</button>
                                </div>
                            </div>
                            <button type="button" id="btn-gen-sample" class="btn btn-ghost btn-sm"
                                    title="Auto-fill sample values from {{ model.X }} placeholders in the template">
                                &#9889; Auto-fill from template
                            </button>
                        </div>
                    </div>
                    <textarea id="preview-json" class="tb-code-textarea" rows="8"
                              placeholder='{ "FieldName": "value" }'>{}</textarea>
                </div>
                <button class="btn btn-primary btn-sm" id="btn-render">Render</button>
                <div id="preview-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                <div class="tb-preview-frame-wrap" id="preview-frame-wrap" style="display:none;">
                    <iframe id="preview-frame" class="tb-preview-frame" title="Template preview"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Loop Wizard Modal -->
    <div class="modal-overlay" id="loop-modal" role="dialog" aria-modal="true" aria-labelledby="loop-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="loop-modal-title" class="modal-title">Insert Loop</span>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body">
                <div class="tb-form-row">
                    <label for="loop-collection">Collection (view field or name)</label>
                    <input type="text" id="loop-collection" placeholder="e.g. Items" autocomplete="off" list="loop-collection-list">
                    <datalist id="loop-collection-list"></datalist>
                </div>
                <div class="tb-form-row">
                    <label for="loop-alias">Item alias</label>
                    <input type="text" id="loop-alias" placeholder="e.g. item" value="item">
                </div>
                <div class="tb-form-row">
                    <label>Starter template</label>
                    <div class="tb-radio-group">
                        <label><input type="radio" name="loop-starter" value="empty" checked> Empty</label>
                        <label><input type="radio" name="loop-starter" value="list"> Bullet list</label>
                        <label><input type="radio" name="loop-starter" value="table"> Table</label>
                    </div>
                </div>
                <div id="loop-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                <div class="tb-modal-actions">
                    <button type="button" id="btn-loop-insert" class="btn btn-primary">Insert</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Conditional Wizard Modal -->
    <div class="modal-overlay" id="conditional-modal" role="dialog" aria-modal="true" aria-labelledby="conditional-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="conditional-modal-title" class="modal-title">Insert Conditional</span>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body">
                <div class="tb-form-row">
                    <label for="cond-field">Field</label>
                    <input type="text" id="cond-field" placeholder="e.g. model.Status" autocomplete="off" list="cond-field-list">
                    <datalist id="cond-field-list"></datalist>
                </div>
                <div class="tb-form-row">
                    <label for="cond-operator">Operator</label>
                    <select id="cond-operator">
                        <option value="==">== (equals)</option>
                        <option value="!=">!= (not equals)</option>
                        <option value="&gt;">&gt; (greater than)</option>
                        <option value="&lt;">&lt; (less than)</option>
                        <option value="contains">contains</option>
                        <option value="!= null">!= null (exists)</option>
                    </select>
                </div>
                <div class="tb-form-row" id="cond-value-row">
                    <label for="cond-value">Value</label>
                    <input type="text" id="cond-value" placeholder="e.g. Active">
                </div>
                <div class="tb-form-row">
                    <label><input type="checkbox" id="cond-include-else"> Include else branch</label>
                </div>
                <div id="cond-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                <div class="tb-modal-actions">
                    <button type="button" id="btn-cond-insert" class="btn btn-primary">Insert</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Save Snippet Modal -->
    <div class="modal-overlay" id="save-snippet-modal" role="dialog" aria-modal="true" aria-labelledby="save-snippet-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="save-snippet-modal-title" class="modal-title">Save as Snippet</span>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body">
                <div class="tb-form-row">
                    <label for="snippet-name">Name</label>
                    <input type="text" id="snippet-name" placeholder="e.g. Standard Footer" maxlength="100">
                </div>
                <div class="tb-form-row">
                    <label for="snippet-desc">Description (optional)</label>
                    <input type="text" id="snippet-desc" placeholder="e.g. Address and disclaimer block" maxlength="300">
                </div>
                <div id="snippet-error" class="tb-error-msg" role="alert" style="display:none;"></div>
                <div class="tb-modal-actions">
                    <button type="button" id="btn-snippet-save" class="btn btn-primary">Save Snippet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Snippet Versions Modal -->
    <div class="modal-overlay" id="versions-modal" role="dialog" aria-modal="true" aria-labelledby="versions-modal-title">
        <div class="modal modal--narrow">
            <div class="modal-header">
                <span id="versions-modal-title" class="modal-title">Snippet History</span>
                <button class="modal-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="modal-body" id="snippet-versions-content">Loading&#8230;</div>
        </div>
    </div>

    <!-- Find & Replace floating panel (non-blocking — no overlay) -->
    <div id="find-replace-panel" class="tb-find-replace" hidden role="dialog" aria-label="Find and Replace">
        <div class="tb-fr-header">
            <span class="tb-fr-title">Find &amp; Replace</span>
            <button type="button" id="btn-fr-close" class="tb-fr-close" aria-label="Close">&#x2715;</button>
        </div>
        <div class="tb-fr-body">
            <div class="tb-fr-row">
                <label for="fr-find" class="tb-fr-label">Find</label>
                <input type="search" id="fr-find" class="tb-fr-input" autocomplete="off" placeholder="Search&#8230;">
            </div>
            <div id="fr-match-count" class="tb-fr-count"></div>
            <div class="tb-fr-row">
                <label for="fr-replace" class="tb-fr-label">Replace</label>
                <input type="text" id="fr-replace" class="tb-fr-input" autocomplete="off" placeholder="Replace with&#8230;">
            </div>
            <div class="tb-fr-options">
                <label class="tb-fr-check"><input type="checkbox" id="fr-case-sensitive"> Case sensitive</label>
                <label class="tb-fr-check"><input type="checkbox" id="fr-whole-word"> Whole word</label>
            </div>
            <div class="tb-fr-actions">
                <button type="button" id="btn-fr-prev" class="btn btn-sm btn-secondary">&#9664; Prev</button>
                <button type="button" id="btn-fr-next" class="btn btn-sm btn-secondary">Next &#9654;</button>
                <button type="button" id="btn-fr-replace" class="btn btn-sm btn-secondary">Replace</button>
                <button type="button" id="btn-fr-replace-all" class="btn btn-sm btn-primary">Replace All</button>
            </div>
        </div>
    </div>

    <!-- Special Characters floating panel (non-blocking — no overlay) -->
    <div id="special-chars-panel" class="tb-special-chars" hidden role="dialog" aria-label="Special Characters">
        <div class="tb-sc-header">
            <span class="tb-sc-title">Special Characters</span>
            <button type="button" id="btn-sc-close" class="tb-sc-close" aria-label="Close">&#x2715;</button>
        </div>
        <div class="tb-sc-search-row">
            <input type="search" id="sc-search" class="tb-sc-search" placeholder="Search&#8230;" autocomplete="off">
        </div>
        <div id="sc-groups" class="tb-sc-groups"></div>
    </div>

    <!-- Scriban Reference floating panel (non-blocking — no overlay) -->
    <div id="ref-panel" class="tb-ref-panel" hidden role="dialog" aria-label="Scriban Reference">
        <div class="tb-ref-header">
            <span class="tb-ref-title">Scriban Reference</span>
            <button type="button" id="btn-ref-close" class="tb-ref-close" aria-label="Close">&#x2715;</button>
        </div>
        <div class="tb-ref-search-row">
            <input type="search" id="ref-search" class="tb-ref-search" placeholder="Search&#8230;" autocomplete="off">
        </div>
        <div id="ref-groups" class="tb-ref-groups">
            @foreach (var group in ScribanReferenceCatalog.Entries.GroupBy(e => e.Group))
            {
                <div class="tb-ref-group" data-group="@group.Key">
                    <div class="tb-ref-group-label">@group.Key</div>
                    @foreach (var entry in group)
                    {
                        <button type="button" class="tb-ref-item" data-code="@entry.Code" data-label="@entry.Label"
                                title="@entry.Label">
                            <span class="tb-ref-item-label">@entry.Label</span>
                            <code class="tb-ref-item-code">@entry.Code</code>
                            @if (entry.Expected is not null)
                            {
                                <span class="tb-ref-item-output">@entry.Expected</span>
                            }
                        </button>
                    }
                </div>
            }
        </div>
    </div>

</div>

<script>
    const templateId = @(Model.Id ?? 0);
    let savedSampleData = @Html.Raw(Json.Encode(Model.SampleData));
    window.tbTemplateId = @(Model.Id ?? 0);
    window.tbIsCreate = @(Model.Id.HasValue ? "false" : "true");
</script>