@using System.Linq
@using TemplateBuilder.Domain.Entities
@model (List<TemplateVersion> Versions, int? CurrentVersionId)

@if (!Model.Versions.Any())
{
    <p style="color:var(--text-muted);font-size:13px;padding:12px 0;">No versions saved yet.</p>
}
else
{
    foreach (var version in Model.Versions.OrderByDescending(v => v.VersionNumber))
    {
        var isCurrent = version.Id == Model.CurrentVersionId;
        <div class="tb-version-card @(isCurrent ? "is-current" : "")" data-version-id="@version.Id">
            <div class="tb-version-header">
                <span class="tb-version-num">v@(version.VersionNumber)</span>
                @if (isCurrent)
                {
                    <span class="tb-version-badge">Current</span>
                }
                <span class="tb-badge @(version.IsActive ? "tb-badge-live" : "tb-badge-draft")">@(version.IsActive ? "Active" : "Draft")</span>
                <span class="tb-version-meta" style="margin-left:auto;">@version.CreatedAt.ToString("dd MMM yyyy")@(!string.IsNullOrWhiteSpace(version.CreatedBy) ? " · " + version.CreatedBy : "")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(version.ChangeComment))
            {
                <div class="tb-version-comment">@version.ChangeComment</div>
            }
            <div style="display:flex;gap:6px;margin-top:8px;">
                <button type="button" class="btn btn-sm btn-secondary"
                        data-version-id="@version.Id"
                        data-version-num="@version.VersionNumber"
                        data-comment="@(version.ChangeComment ?? "")"
                        data-created-at="@version.CreatedAt.ToString("dd MMM yyyy")"
                        onclick="openCompareView(this)">Compare</button>
                @if (!isCurrent)
                {
                    <button type="button" class="btn btn-sm btn-primary"
                            onclick="restoreVersion(this, @version.Id, @version.VersionNumber)">Restore</button>
                }
            </div>
        </div>
    }
}