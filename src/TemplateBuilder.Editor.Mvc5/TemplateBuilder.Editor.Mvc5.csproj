<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\TemplateBuilder.Application\TemplateBuilder.Application.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\TemplateBuilder.Infrastructure.EF6\TemplateBuilder.Infrastructure.EF6.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Runtime dependencies of the bundled Domain/Application/Infrastructure.EF6 assemblies:
         the ProjectReferences above carry PrivateAssets=all (their dlls are bundled into
         lib/net48 by BundleInternalAssemblies), so their package dependencies must be
         declared here explicitly or a consumer gets FileNotFoundException at runtime. -->
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="System.Text.Json" Version="10.0.8" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.995" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebHelpers" Version="3.3.0" />
    <PackageReference Include="Unity" Version="5.11.10" />
    <PackageReference Include="Unity.Mvc5" Version="1.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RazorGenerator.Mvc" Version="2.4.9" />
    <PackageReference Include="RazorGenerator.MsBuild" Version="2.5.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="Views/**/*.cshtml" />
    <None Include="Views/**/*.cshtml">
      <Generator>RazorGenerator</Generator>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="StaticAssets\template-editor.js" LogicalName="TemplateBuilder.Editor.Mvc5.StaticAssets.template-editor.js" />
    <EmbeddedResource Include="StaticAssets\template-editor.css" LogicalName="TemplateBuilder.Editor.Mvc5.StaticAssets.template-editor.css" />
    <EmbeddedResource Include="StaticAssets\suneditor.min.js" LogicalName="TemplateBuilder.Editor.Mvc5.StaticAssets.suneditor.min.js" />
    <EmbeddedResource Include="StaticAssets\suneditor.min.css" LogicalName="TemplateBuilder.Editor.Mvc5.StaticAssets.suneditor.min.css" />
  </ItemGroup>
  <PropertyGroup>
    <!-- RazorGenerator.MsBuild's RazorCodeGen task targets Microsoft.Build.Utilities.v4.0 (the
         .NET Framework MSBuild) and cannot load under dotnet's Core MSBuild (MSB4062). On the
         client's Windows MSBuild the package target below runs normally; on Core MSBuild (Linux)
         we disable it and run the same RazorGenerator.Core engine through eng/RazorGenDriver.cs
         instead, producing identical obj/CodeGen output. See BLOCKERS.md entry #10. -->
    <PrecompileRazorFiles Condition="'$(MSBuildRuntimeType)' == 'Core'">false</PrecompileRazorFiles>
  </PropertyGroup>
  <Target Name="PrecompileRazorFilesOnCore" BeforeTargets="CoreCompile" Condition="'$(MSBuildRuntimeType)' == 'Core'">
    <PropertyGroup>
      <RazorGenRunDir>$(MSBuildProjectDirectory)\obj\razorgen\</RazorGenRunDir>
      <RazorGenToolsDir>$(NuGetPackageRoot)razorgenerator.msbuild\2.5.0\tools\</RazorGenToolsDir>
    </PropertyGroup>
    <MakeDir Directories="$(RazorGenRunDir)" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)/obj/CodeGen" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/obj/CodeGen" />
    <ItemGroup>
      <RazorGenV1 Include="$(RazorGenToolsDir)v1\*.dll" />
      <RazorGenV2 Include="$(RazorGenToolsDir)v2\*.dll" />
      <RazorGenV3 Include="$(RazorGenToolsDir)v3\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="$(RazorGenToolsDir)RazorGenerator.Core.dll" DestinationFolder="$(RazorGenRunDir)" />
    <Copy SourceFiles="@(RazorGenV1)" DestinationFolder="$(RazorGenRunDir)v1\" />
    <Copy SourceFiles="@(RazorGenV2)" DestinationFolder="$(RazorGenRunDir)v2\" />
    <Copy SourceFiles="@(RazorGenV3)" DestinationFolder="$(RazorGenRunDir)v3\" />
    <Exec Command="mcs -nologo -warn:0 -target:exe -out:$(RazorGenRunDir)RazorGenDriver.exe -r:$(RazorGenRunDir)RazorGenerator.Core.dll &quot;$(MSBuildProjectDirectory)\..\..\eng\RazorGenDriver.cs&quot;" />
    <Exec Command="mono $(RazorGenRunDir)RazorGenDriver.exe --project-root $(MSBuildProjectDirectory) --codegen-dir $(MSBuildProjectDirectory)/obj/CodeGen --root-namespace $(RootNamespace)" />
    <ItemGroup>
      <Compile Include="$(MSBuildProjectDirectory)/obj/CodeGen/**/*.cs" />
    </ItemGroup>
  </Target>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>TemplateBuilder.Editor.Mvc5</PackageId>
    <Version>1.1.0</Version>
    <Authors>TemplateBuilder</Authors>
    <Description>Full template management UI (create, edit, version history, compare, snippets) for ASP.NET MVC 5 / .NET Framework 4.8. Call container.RegisterTemplateBuilderEditor(...) then wire up routes.</Description>
    <PackageTags>template;scriban;html;editor;mvc5;netframework</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="tools\install.ps1" Pack="true" PackagePath="tools\" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <Target Name="BundleInternalAssemblies" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="$(OutputPath)TemplateBuilder.Domain.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
      <None Include="$(OutputPath)TemplateBuilder.Application.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
      <None Include="$(OutputPath)TemplateBuilder.Infrastructure.EF6.dll" Pack="true" PackagePath="lib\$(TargetFramework)\" Visible="false" />
    </ItemGroup>
  </Target>
</Project>